---
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
const pt = Astro.currentLocale === 'pt-pt';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<footer class="guide-footer">
  <Pagination />
  <div class="footer-main">
    <a class="footer-brand" href={`${base}${pt ? 'pt-pt/' : ''}`}>
      <img src={`${base}git-logo.svg`} width="25" height="25" alt="" />
      <span>{pt ? 'Guia de Git' : 'Git Guide'}</span>
    </a>
    <p>{pt ? 'Criado por' : 'Created by'} <a href="https://github.com/joao-sintra">João Sintra</a></p>
    <a class="source-link" href="https://github.com/joao-sintra/git-guide">{pt ? 'Ver no GitHub' : 'View on GitHub'} <span aria-hidden="true">↗</span></a>
    <div class="mobile-theme"><ThemeSelect /></div>
  </div>
  <div class="footer-notes">
    <span>{pt ? 'Criado com' : 'Built with'} <a href="https://astro.build/">Astro</a> + <a href="https://starlight.astro.build/">Starlight</a></span>
    <span>{pt ? 'Logótipo Git por' : 'Git logo by'} <a href="https://git-scm.com/community/logos">Jason Long</a> · <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a></span>
  </div>
</footer>
<style>
  .guide-footer { margin-top: 3rem; }
  .footer-main { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem 2rem; padding: 1.8rem 0 1rem; margin-top: 2rem; border-top: 1px solid var(--sl-color-gray-5); font-size: .8rem; }
  .footer-brand { display: inline-flex; align-items: center; gap: .6rem; color: var(--sl-color-white); font-weight: 700; font-size: 1rem; text-decoration: none; }
  p { margin: 0; color: var(--sl-color-gray-2); }
  p a { color: var(--sl-color-white); font-weight: 600; }
  a { text-underline-offset: .2em; }
  .source-link { color: var(--sl-color-accent-high); text-decoration: none; }
  .footer-notes { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1.5rem; padding-bottom: 1.2rem; font-size: .66rem; color: var(--sl-color-gray-3); }
  .footer-notes a { color: inherit; }
  .mobile-theme { display: none; }
  @media (max-width: 49.99rem) { .mobile-theme { display: block; } }
</style>
